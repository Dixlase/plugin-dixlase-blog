{
    "name": "plugins/dixlase-blog",
    "description": "This is the Dixlase Blog plugin.",
    "type": "dixlase-plugin",
    "version": "1.0.0",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "exc-D inc.",
            "email": "office@exc-d.com",
            "homepage": "https://exc-d.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\DixlaseBlog\\App\\": "app/"
        }
    },
    "extra": {
        "display-name": "Dixlase Blog",
        "keywords": [
            "laravel",
            "plugin",
            "blog"
        ],
        "slug": "dixlase-blog",
        "category": "content",
        "laravel": {
            "providers": [
                "Plugins\\DixlaseBlog\\App\\Providers\\DixlaseBlogServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
