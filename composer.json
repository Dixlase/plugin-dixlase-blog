{
    "name": "dixlase/dixlase-blog",
    "description": "Blog plugin for Dixlase: posts, categories and tags, comments, a sidebar, archives and an RSS feed.",
    "type": "dixlase-plugin",
    "version": "0.3.0",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "exc-D inc.",
            "email": "info@dixlase.org",
            "homepage": "https://exc-d.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\DixlaseBlog\\App\\": "app/",
            "Plugins\\DixlaseBlog\\Database\\Seeders\\": "database/seeders/",
            "Plugins\\DixlaseBlog\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "display-name": "Dixlase Blog",
        "keywords": [
            "laravel",
            "plugin",
            "blog"
        ],
        "slug": "dixlase-blog",
        "category": "content",
        "laravel": {
            "providers": [
                "Plugins\\DixlaseBlog\\App\\Providers\\DixlaseBlogServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
