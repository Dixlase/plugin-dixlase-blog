{
    "name": "my-software/plugins-blog-plugin",
    "description": "This is the BlogPlugin plugin.",
    "version": "1.0.0",
    "license": "AGPL-3.0",
    "authors": [
        {
            "name": "Your Name or Company",
            "email": "your-email@example.com",
            "homepage": "https://yourwebsite.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "some/dependency": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\BlogPlugin\\App\\": "app/"
        }
    },
    "extra": {
        "display-name": "BlogPlugin",
        "keywords": ["laravel", "plugin", "custom"],
        "slug": "{{ slug }}",
        "category": "plugin",
        "laravel": {
            "providers": [
                "Plugins\\BlogPlugin\\App\\Providers\\BlogPluginServiceProvider"
            ]
        }
    }
}
