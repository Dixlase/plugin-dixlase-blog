            ],
            "admin": [],
            "front": [
                "js/front.js"
            ]
        },
        "contracts": [
            "RouteSlugProvider",
            "CaptchaFormProviderInterface",
            "DashboardNotificationProviderInterface"
        ],
        "migrations": true,
        "commands": true,
        "middleware": false
    },
