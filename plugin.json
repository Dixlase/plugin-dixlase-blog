            "read": false,
            "write": false,
            "create": false,
            "delete": false
        },
        "mail": {
            "send": true,
            "bulk_send": false
        },
        "content": {
            "read_other_plugins": [
                "dixlase-seo"
            ],
            "write_other_plugins": []
        },
        "system": {
            "register_shortcodes": true,
            "register_middleware": false,
            "register_commands": true,
            "register_blade_directives": false,
            "modify_routes": false
        },
        "_optional": [],
        "_notes": {
            "en": "Stores blog posts, categories (hierarchical via parent_id), tags, post-tag and post-category pivots, post revisions, comments and the blog settings in own tables under the plg_dixlase_blog_* prefix. Sends a new-comment notification mail to the address set on the blog settings screen, when notification is turned on (mail.send), and registers dls:blog:prune-comment-ips, scheduled daily, which clears stored commenter IP addresses after the retention period set on the blog settings screen. It also registers dls:blog:publish-scheduled, scheduled every minute, which marks scheduled posts whose publish datetime has passed as published. Reads content.revision.retention_count via settings.read_core to use the shared RevisionService and revision UI components. Declares core_tables_read: ['media', 'members'] because BlogPost.featuredMedia is a belongsTo against the core media table and BlogPost.author / BlogPostRevision.creator are belongsTo against members — all read-only, no writes (featured images are picked from the core media library, never uploaded by this plugin). Per the v0.1.0 plugin guidelines the belongsTo convention is acceptable; migrating these reads behind MediaRepositoryInterface / MemberRepositoryInterface is deferred to v0.2 and is contingent on those contracts gaining first-class relation eager-loading support — otherwise a raw-id + repository pattern would introduce N+1 risk on list views.",
            "ja": "plg_dixlase_blog_* 接頭辞の独自テーブルでブログ記事、階層カテゴリ (parent_id 方式)、タグ、記事-タグ/記事-カテゴリ pivot、リビジョン、コメント、ブログの設定を保存する。通知をオンにしているとき、ブログの設定画面で決めたアドレスに新しいコメントの通知メールを送り (mail.send)、毎日動く dls:blog:prune-comment-ips を登録する。このコマンドは、ブログの設定画面で決めた保存期間を過ぎたコメント投稿者の IP アドレスを消す。また、毎分動く dls:blog:publish-scheduled を登録する。このコマンドは、公開日時を過ぎた予約の記事を公開に切り替える。共有 RevisionService とリビジョン UI コンポーネントを利用するため settings.read_core 経由で content.revision.retention_count を読み取る。core_tables_read には ['media', 'members'] を宣言しており、これは BlogPost.featuredMedia がコア media テーブルへの belongsTo、BlogPost.author と BlogPostRevision.creator が members への belongsTo であるため (いずれも読み取りのみ。アイキャッチ画像はコアの media ライブラリから選択するだけで本プラグインからのアップロード書き込みは行わない)。v0.1.0 のプラグインガイドラインに従い belongsTo の慣行は許容範囲とし、これらを MediaRepositoryInterface / MemberRepositoryInterface 経由に置き換えるのは v0.2 以降に先送りする。さらにこの置き換えはコア側で当該 Contract がリレーションの eager-loading を一級サポートしてからとし、それ以前に raw id + repository に切り替えると一覧画面で N+1 を招くため見送る。"
        }
    },
    "declares": {
        "configs": {
            "roles": true,
            "database_cleanup": true,
            "navigation": true
        },
        "assets": {
            "common": [
