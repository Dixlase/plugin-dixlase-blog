{
    "name": "Dixlase Blog",
    "package_name": "dixlase/dixlase-blog",
    "slug": "dixlase-blog",
    "version": "0.3.0",
    "description": {
        "en": "Provides a blog: posts with revisions, a trash and featured images, hierarchical categories and tags, comments with moderation, notification mail and CAPTCHA, a settings screen, a configurable sidebar, search and date archives, pinned posts, previous / next and related posts, share buttons, breadcrumbs and an RSS feed. Works with DixlaseSEO for meta tags and the sitemap.",
        "ja": "ブログ機能を提供します。リビジョン、ゴミ箱、アイキャッチ画像のある記事、階層カテゴリとタグ、承認・通知メール・CAPTCHA に対応したコメント、設定画面、設定できるサイドバー、検索と日付のアーカイブ、固定表示、前後の記事と関連記事、共有ボタン、パンくずリスト、RSS フィードを備えます。DixlaseSEO でメタタグとサイトマップに対応します。"
    },
    "author": "exc-D inc.",
    "author_id": "exc-d-inc",
    "authority_key_id": "dixlase-authority-2026",
    "email": "info@dixlase.org",
    "url": "https://exc-d.com",
    "license": "GPL-3.0-or-later",
    "license_template": "license-dual-gpl.txt",
    "commercial_license": {
        "available": true,
        "file": "LICENSE.commercial",
        "contact": "info@dixlase.org"
    },
    "assets": {
        "license": null,
        "attributions_file": null,
        "third_party": []
    },
    "thumbnail": "thumbnail.png",
    "namespace": "Plugins\\DixlaseBlog",
    "providers": [
        "Plugins\\DixlaseBlog\\App\\Providers\\DixlaseBlogServiceProvider"
    ],
    "type": "dixlase-plugin",
    "category": "content",
    "tags": [
        "blog",
        "posts",
        "content",
        "comments",
        "categories",
        "tags",
        "rss"
    ],
    "capabilities": [
        "seo-meta",
        "linkable",
        "multilingual-content",
        "captcha"
    ],
    "multilingual_content": {
        "types": [
            {
                "key": "dixlase-blog:post",
                "model": "Plugins\\DixlaseBlog\\App\\Models\\BlogPost",
                "label_field": "title",
                "fields": [
                    {
                        "name": "title",
                        "type": "text",
                        "rules": "required|string|max:255"
                    },
                    {
                        "name": "excerpt",
                        "type": "textarea",
                        "rules": "nullable|string|max:500"
                    },
                    {
                        "name": "content",
                        "type": "richtext",
                        "rules": "nullable|string|max:500000"
                    },
                    {
                        "name": "seo_description",
                        "type": "textarea",
                        "rules": "nullable|string|max:300"
                    },
                    {
                        "name": "featured_media_id",
                        "type": "media"
                    },
                    {
                        "name": "seo_ogp_media_id",
                        "type": "media"
                    }
                ]
            },
            {
                "key": "dixlase-blog:category",
                "model": "Plugins\\DixlaseBlog\\App\\Models\\BlogCategory",
                "label_field": "label",
                "fields": [
                    {
                        "name": "label",
                        "type": "text",
                        "rules": "required|string|max:255"
                    }
                ]
            },
            {
                "key": "dixlase-blog:tag",
                "model": "Plugins\\DixlaseBlog\\App\\Models\\BlogTag",
                "label_field": "name",
                "fields": [
                    {
                        "name": "name",
                        "type": "text",
                        "rules": "required|string|max:100"
                    }
                ]
            }
        ]
    },
    "requires": {
        "dixlase": ">=0.2.0",
        "dixlase_api": "^0.1",
        "php": ">=8.2"
    },
