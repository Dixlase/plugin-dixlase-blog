{
    "name": "Dixlase Blog",
    "package_name": "dixlase/dixlase-blog",
    "slug": "dixlase-blog",
    "version": "0.1.0",
    "description": {
        "en": "Provides blog functionality with posts, hierarchical categories, tags, revisions, soft-delete trash, featured images, excerpts, and public list/detail/archive routes plus an RSS feed.",
        "ja": "ブログ機能を提供します。記事、階層カテゴリ、タグ、リビジョン、ゴミ箱(ソフトデリート)、アイキャッチ画像、抜粋、公開側 (一覧/詳細/カテゴリ・タグアーカイブ) と RSS フィードを備えます。"
    },
    "author": "exc-D inc.",
    "author_id": "exc-d-inc",
    "authority_key_id": "dixlase-authority-2026",
    "email": "info@dixlase.org",
    "url": "https://exc-d.com",
    "license": "GPL-3.0-or-later",
    "license_template": "license-dual-gpl.txt",
    "commercial_license": {
        "available": true,
        "file": "LICENSE.commercial",
        "contact": "info@dixlase.org"
    },
    "assets": {
        "license": null,
        "attributions_file": null,
        "third_party": []
    },
    "namespace": "Plugins\\DixlaseBlog",
    "providers": [
        "Plugins\\DixlaseBlog\\App\\Providers\\DixlaseBlogServiceProvider"
    ],
    "type": "dixlase-plugin",
    "category": "content",
    "tags": [
        "blog",
        "posts",
        "content",
        "rss"
    ],
    "capabilities": [
        "seo-meta",
        "linkable",
        "multilingual-content",
        "captcha"
    ],
    "multilingual_content": {
        "types": [
            {
                "key": "dixlase-blog:post",
                "model": "Plugins\\DixlaseBlog\\App\\Models\\BlogPost",
                "label_field": "title",
                "fields": [
                    {
                        "name": "title",
                        "type": "text",
                        "rules": "required|string|max:255"
                    },
                    {
                        "name": "excerpt",
                        "type": "textarea",
                        "rules": "nullable|string|max:500"
                    },
                    {
                        "name": "content",
                        "type": "richtext",
                        "rules": "nullable|string|max:500000"
                    },
                    {
                        "name": "seo_description",
                        "type": "textarea",
                        "rules": "nullable|string|max:300"
                    }
                ]
            },
            {
                "key": "dixlase-blog:category",
                "model": "Plugins\\DixlaseBlog\\App\\Models\\BlogCategory",
                "label_field": "label",
                "fields": [
                    {
                        "name": "label",
                        "type": "text",
                        "rules": "required|string|max:255"
                    }
                ]
            },
            {
                "key": "dixlase-blog:tag",
                "model": "Plugins\\DixlaseBlog\\App\\Models\\BlogTag",
                "label_field": "name",
                "fields": [
                    {
                        "name": "name",
                        "type": "text",
                        "rules": "required|string|max:100"
                    }
                ]
            }
        ]
    },
    "requires": {
        "dixlase": "^0.1.0",
        "dixlase_api": "^0.1",
        "php": ">=8.2"
    },
    "provides": {
        "admin_menu": true,
        "front_routes": true,
        "api_routes": false,
        "settings_page": true,
        "shortcodes": false,
        "helper_functions": false
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables": [],
            "core_tables_read": [
                "media",
                "members"
            ],
            "core_tables_write": []
        },
        "storage": {
            "own_directory": false,
            "public_uploads": false,
            "temp_files": false
        },
        "settings": {
            "read_core": true,
            "write_own": false
        },
        "members": {
            "read": false,
            "write": false,
            "create": false,
            "delete": false
        },
        "mail": {
            "send": true,
            "bulk_send": false
        },
        "content": {
            "read_other_plugins": [
                "dixlase-seo"
            ],
            "write_other_plugins": []
        },
        "system": {
            "register_shortcodes": false,
            "register_middleware": false,
            "register_commands": false,
            "register_blade_directives": false,
            "modify_routes": false
        },
        "_optional": [],
        "_notes": {
            "en": "Stores blog posts, categories (hierarchical via parent_id), tags, post-tag and post-category pivots, and post revisions in own tables under the plg_dixlase_blog_* prefix. Reads content.revision.retention_count via settings.read_core to use the shared RevisionService and revision UI components. Declares core_tables_read: ['media', 'members'] because BlogPost.featuredMedia is a belongsTo against the core media table and BlogPost.author / BlogPostRevision.creator are belongsTo against members — all read-only, no writes (featured images are picked from the core media library, never uploaded by this plugin). Per the v0.1.0 plugin guidelines the belongsTo convention is acceptable; migrating these reads behind MediaRepositoryInterface / MemberRepositoryInterface is deferred to v0.2 and is contingent on those contracts gaining first-class relation eager-loading support — otherwise a raw-id + repository pattern would introduce N+1 risk on list views.",
            "ja": "plg_dixlase_blog_* 接頭辞の独自テーブルでブログ記事、階層カテゴリ (parent_id 方式)、タグ、記事-タグ/記事-カテゴリ pivot、リビジョンを保存する。共有 RevisionService とリビジョン UI コンポーネントを利用するため settings.read_core 経由で content.revision.retention_count を読み取る。core_tables_read には ['media', 'members'] を宣言しており、これは BlogPost.featuredMedia がコア media テーブルへの belongsTo、BlogPost.author と BlogPostRevision.creator が members への belongsTo であるため (いずれも読み取りのみ。アイキャッチ画像はコアの media ライブラリから選択するだけで本プラグインからのアップロード書き込みは行わない)。v0.1.0 のプラグインガイドラインに従い belongsTo の慣行は許容範囲とし、これらを MediaRepositoryInterface / MemberRepositoryInterface 経由に置き換えるのは v0.2 以降に先送りする。さらにこの置き換えはコア側で当該 Contract がリレーションの eager-loading を一級サポートしてからとし、それ以前に raw id + repository に切り替えると一覧画面で N+1 を招くため見送る。"
        }
    },
    "declares": {
        "configs": {
            "roles": true,
            "database_cleanup": false,
            "navigation": true
        },
        "assets": {
            "common": [
                "js/app.js",
                "css/style.scss"
            ],
            "admin": [],
            "front": [
                "js/front.js"
            ]
        },
        "contracts": [
            "RouteSlugProvider",
            "CaptchaFormProviderInterface",
            "DashboardNotificationProviderInterface"
        ],
        "migrations": true,
        "commands": false,
        "middleware": false
    }
}