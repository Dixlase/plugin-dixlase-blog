{
    "name": "Dixlase Blog",
    "package_name": "plugins/dixlase-blog",
    "slug": "dixlase-blog",
    "version": "1.0.0",
    "description": {
        "en": "Provides blog functionality with posts, hierarchical categories, tags, revisions, soft-delete trash, featured images, excerpts, and public list/detail/archive routes plus an RSS feed.",
        "ja": "ブログ機能を提供します。記事、階層カテゴリ、タグ、リビジョン、ゴミ箱(ソフトデリート)、アイキャッチ画像、抜粋、公開側 (一覧/詳細/カテゴリ・タグアーカイブ) と RSS フィードを備えます。"
    },
    "author": "exc-D inc.",
    "author_id": "exc-d-inc",
    "authority_key_id": "dixlase-authority-2026",
    "email": "office@exc-d.com",
    "url": "https://exc-d.com",
    "license": "GPL-3.0-or-later",
    "license_template": "license-dual-gpl.txt",
    "commercial_license": {
        "available": true,
        "file": "LICENSE.commercial",
        "contact": "office@exc-d.com"
    },
    "assets": {
        "license": null,
        "attributions_file": null,
        "third_party": []
    },
    "namespace": "Plugins\\DixlaseBlog",
    "providers": [
        "Plugins\\DixlaseBlog\\App\\Providers\\DixlaseBlogServiceProvider"
    ],
    "type": "dixlase-plugin",
    "category": "content",
    "tags": [
        "blog",
        "posts",
        "content",
        "rss"
    ],
    "capabilities": [],
    "requires": {
        "dixlase": "^0.1.0",
        "php": ">=8.2"
    },
    "provides": {
        "admin_menu": true,
        "front_routes": true,
        "api_routes": false,
        "settings_page": true,
        "shortcodes": false,
        "helper_functions": false
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables": [],
            "core_tables_read": [],
            "core_tables_write": []
        },
        "storage": {
            "own_directory": true,
            "public_uploads": true,
            "temp_files": false
        },
        "settings": {
            "read_core": true,
            "write_own": true
        },
        "members": {
            "read": true,
            "write": false,
            "create": false,
            "delete": false
        },
        "mail": {
            "send": false,
            "bulk_send": false
        },
        "content": {
            "read_other_plugins": [],
            "write_other_plugins": []
        },
        "system": {
            "register_shortcodes": false,
            "register_middleware": false,
            "register_commands": false,
            "register_blade_directives": false,
            "modify_routes": false
        },
        "_optional": [],
        "_notes": {
            "en": "Stores blog posts, categories (hierarchical via parent_id), tags, post-tag and post-category pivots, and post revisions in own tables under the blog_plugin_* prefix. Reads members table to display author information. Reads content.revision.retention_count via settings.read_core to use the shared RevisionService and revision UI components. Uses public_uploads for featured images. DixlaseSEO and DixlaseMultilingual integrations are deferred to a later version (see .backlog/dixlase-blog-deferred.md in the Core repository).",
            "ja": "blog_plugin_* 接頭辞の独自テーブルでブログ記事、階層カテゴリ (parent_id 方式)、タグ、記事-タグ/記事-カテゴリ pivot、リビジョンを保存します。投稿者表示のため members テーブルを読み取ります。共有 RevisionService とリビジョン UI コンポーネントを利用するため settings.read_core 経由で content.revision.retention_count を読み取ります。アイキャッチ画像保存のため public_uploads を使用します。DixlaseSEO と DixlaseMultilingual との連携は後続バージョンへ先送り (Core リポジトリの .backlog/dixlase-blog-deferred.ja.md を参照)。"
        }
    },
    "files": {},
    "signing": {
        "algo": "ed25519",
        "key_id": "dixlase-authority-2026",
        "signed_at": null
    },
    "declares": {
        "configs": {
            "roles": false,
            "database_cleanup": false,
            "navigation": true
        },
        "assets": {
            "common": [
                "js/app.js",
                "css/style.scss"
            ],
            "admin": [],
            "front": []
        },
        "contracts": [],
        "migrations": true,
        "commands": false,
        "middleware": false
    }
}
