{
    "name": "Dixlase Blog",
    "package_name": "dixlase/dixlase-blog",
    "slug": "dixlase-blog",
    "version": "0.1.1",
    "description": {
        "en": "Provides a blog: posts with revisions, a trash and featured images, hierarchical categories and tags, comments with moderation, notification mail and CAPTCHA, a settings screen, a configurable sidebar, search and date archives, pinned posts, previous / next and related posts, share buttons, breadcrumbs and an RSS feed. Works with DixlaseSEO for meta tags and the sitemap.",
        "ja": "ブログ機能を提供します。リビジョン、ゴミ箱、アイキャッチ画像のある記事、階層カテゴリとタグ、承認・通知メール・CAPTCHA に対応したコメント、設定画面、設定できるサイドバー、検索と日付のアーカイブ、固定表示、前後の記事と関連記事、共有ボタン、パンくずリスト、RSS フィードを備えます。DixlaseSEO でメタタグとサイトマップに対応します。"
    },
    "author": "exc-D inc.",
    "author_id": "exc-d-inc",
    "authority_key_id": "dixlase-authority-2026",
    "email": "info@dixlase.org",
    "url": "https://exc-d.com",
    "license": "GPL-3.0-or-later",
    "license_template": "license-dual-gpl.txt",
    "commercial_license": {
        "available": true,
        "file": "LICENSE.commercial",
        "contact": "info@dixlase.org"
    },
    "assets": {
        "license": null,
        "attributions_file": null,
        "third_party": []
    },
    "thumbnail": "thumbnail.png",
    "namespace": "Plugins\\DixlaseBlog",
    "providers": [
        "Plugins\\DixlaseBlog\\App\\Providers\\DixlaseBlogServiceProvider"
    ],
    "type": "dixlase-plugin",
    "category": "content",
    "tags": [
        "blog",
        "posts",
        "content",
        "comments",
        "categories",
        "tags",
        "rss"
    ],
    "capabilities": [
        "seo-meta",
        "linkable",
        "multilingual-content",
        "captcha"
    ],
    "multilingual_content": {
        "types": [
            {
                "key": "dixlase-blog:post",
                "model": "Plugins\\DixlaseBlog\\App\\Models\\BlogPost",
                "label_field": "title",
                "fields": [
                    {
                        "name": "title",
                        "type": "text",
                        "rules": "required|string|max:255"
                    },
                    {
                        "name": "excerpt",
                        "type": "textarea",
                        "rules": "nullable|string|max:500"
                    },
                    {
                        "name": "content",
                        "type": "richtext",
                        "rules": "nullable|string|max:500000"
                    },
                    {
                        "name": "seo_description",
                        "type": "textarea",
                        "rules": "nullable|string|max:300"
                    },
                    {
                        "name": "featured_media_id",
                        "type": "media"
                    },
                    {
                        "name": "seo_ogp_media_id",
                        "type": "media"
                    }
                ]
            },
            {
                "key": "dixlase-blog:category",
                "model": "Plugins\\DixlaseBlog\\App\\Models\\BlogCategory",
                "label_field": "label",
                "fields": [
                    {
                        "name": "label",
                        "type": "text",
                        "rules": "required|string|max:255"
                    }
                ]
            },
            {
                "key": "dixlase-blog:tag",
                "model": "Plugins\\DixlaseBlog\\App\\Models\\BlogTag",
                "label_field": "name",
                "fields": [
                    {
                        "name": "name",
                        "type": "text",
                        "rules": "required|string|max:100"
                    }
                ]
            }
        ]
    },
    "requires": {
        "dixlase": "^0.1.13",
        "dixlase_api": "^0.1",
        "php": ">=8.2"
    },
    "provides": {
        "admin_menu": true,
        "front_routes": true,
        "api_routes": false,
        "settings_page": true,
        "shortcodes": false,
        "helper_functions": false
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables": [],
            "core_tables_read": [
                "media",
                "members"
            ],
            "core_tables_write": []
        },
        "storage": {
            "own_directory": false,
            "public_uploads": false,
            "temp_files": false
        },
        "settings": {
            "read_core": true,
            "write_own": false
        },
        "members": {
            "read": false,
            "write": false,
            "create": false,
            "delete": false
        },
        "mail": {
            "send": true,
            "bulk_send": false
        },
        "content": {
            "read_other_plugins": [
                "dixlase-seo"
            ],
            "write_other_plugins": []
        },
        "system": {
            "register_shortcodes": false,
            "register_middleware": false,
            "register_commands": true,
            "register_blade_directives": false,
            "modify_routes": false
        },
        "_optional": [],
        "_notes": {
            "en": "Stores blog posts, categories (hierarchical via parent_id), tags, post-tag and post-category pivots, post revisions, comments and the blog settings in own tables under the plg_dixlase_blog_* prefix. Sends a new-comment notification mail to the address set on the blog settings screen, when notification is turned on (mail.send), and registers dls:blog:prune-comment-ips, scheduled daily, which clears stored commenter IP addresses after the retention period set on the blog settings screen. Reads content.revision.retention_count via settings.read_core to use the shared RevisionService and revision UI components. Declares core_tables_read: ['media', 'members'] because BlogPost.featuredMedia is a belongsTo against the core media table and BlogPost.author / BlogPostRevision.creator are belongsTo against members — all read-only, no writes (featured images are picked from the core media library, never uploaded by this plugin). Per the v0.1.0 plugin guidelines the belongsTo convention is acceptable; migrating these reads behind MediaRepositoryInterface / MemberRepositoryInterface is deferred to v0.2 and is contingent on those contracts gaining first-class relation eager-loading support — otherwise a raw-id + repository pattern would introduce N+1 risk on list views.",
            "ja": "plg_dixlase_blog_* 接頭辞の独自テーブルでブログ記事、階層カテゴリ (parent_id 方式)、タグ、記事-タグ/記事-カテゴリ pivot、リビジョン、コメント、ブログの設定を保存する。通知をオンにしているとき、ブログの設定画面で決めたアドレスに新しいコメントの通知メールを送り (mail.send)、毎日動く dls:blog:prune-comment-ips を登録する。このコマンドは、ブログの設定画面で決めた保存期間を過ぎたコメント投稿者の IP アドレスを消す。共有 RevisionService とリビジョン UI コンポーネントを利用するため settings.read_core 経由で content.revision.retention_count を読み取る。core_tables_read には ['media', 'members'] を宣言しており、これは BlogPost.featuredMedia がコア media テーブルへの belongsTo、BlogPost.author と BlogPostRevision.creator が members への belongsTo であるため (いずれも読み取りのみ。アイキャッチ画像はコアの media ライブラリから選択するだけで本プラグインからのアップロード書き込みは行わない)。v0.1.0 のプラグインガイドラインに従い belongsTo の慣行は許容範囲とし、これらを MediaRepositoryInterface / MemberRepositoryInterface 経由に置き換えるのは v0.2 以降に先送りする。さらにこの置き換えはコア側で当該 Contract がリレーションの eager-loading を一級サポートしてからとし、それ以前に raw id + repository に切り替えると一覧画面で N+1 を招くため見送る。"
        }
    },
    "declares": {
        "configs": {
            "roles": true,
            "database_cleanup": true,
            "navigation": true
        },
        "assets": {
            "common": [
                "js/app.js",
